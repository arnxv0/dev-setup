#!/usr/bin/env bash
switch_to() {
    if [[ -z $TMUX ]]; then
        tmux attach-session -t $1
    else
        tmux switch-client -t $1
    fi
}

has_session() {
    tmux list-sessions | grep -q "^$1:"
}

# Session name = <2-char parent hint>-<folder>.
#
# The old scheme was just the folder basename, which collided constantly:
# ~/Desktop/Flutter/Projects/blit and ~/Desktop/WebDev/blit both became "blit",
# so picking either one switched you into whichever session already existed.
# Same for katkode-website, pointiv, and generic names like src/public/static.
#
# The parent directory disambiguates them (pr-blit vs we-blit) and doubles as a
# reminder of where you are. A 4-char path hash is appended only if two paths
# somehow still produce the same name.
session_name_for() {
    local dir="$1" base parent pfx name
    base=$(basename "$dir" | tr . _)
    if [ "$(dirname "$dir")" = "$HOME" ]; then
        parent="home"
    else
        parent=$(basename "$(dirname "$dir")")
    fi
    pfx=$(printf '%s' "$parent" | tr -cd '[:alnum:]' | cut -c1-2 | tr '[:upper:]' '[:lower:]')
    [ -z "$pfx" ] && pfx="xx"
    name="$pfx-$base"
    # tmux forbids '.' and ':' in session names
    printf '%s' "$name" | tr '.:' '__'
}

legacy_session_name_for() {
    basename "$1" | tr . _
}

# Find the saved session for a FOLDER. This is the primary lookup: what you
# picked is a directory, so saved state should be found by path regardless of
# what the session was named. Also recovers sessions whose name does not match
# their folder at all (e.g. "disd" living in CS249-discord-service).
snapshot_session_for_path() {
    local snap="${TMUX_SNAPSHOT_DIR:-$HOME/.local/share/tmux-state}/snapshot"
    [ -f "$snap" ] || return 1
    local dir="${1%/}"
    awk -F'\t' -v d="$dir" '
        $1=="session" { wins[$2]=$3; if ($5==d) hit[$2]=1 }
        $1=="pane"    { if ($6==d) hit[$2]=1 }
        END { best=""; bw=-1
              for (s in hit) if (wins[s]+0 > bw) { bw=wins[s]+0; best=s }
              if (best!="") print best }
    ' "$snap"
}

snapshot_has() {
    local snap="${TMUX_SNAPSHOT_DIR:-$HOME/.local/share/tmux-state}/snapshot"
    [ -f "$snap" ] || return 1
    awk -F'\t' -v s="$1" '$1=="session" && $2==s {f=1} END{exit !f}' "$snap"
}

RESTORE="$HOME/.local/custom_setup_bin/tmux-restore"

# Rebuild a project from the snapshot when one exists: its windows, their cwds,
# nvim, and `claude --resume <session-id>` for the exact prior conversation.
# Falls back to the generic layout below for projects we have never seen.
start_session() {
    local name="$1" dir="$2"
    if snapshot_has "$name" && [ -x "$RESTORE" ]; then
        if "$RESTORE" "$name" >/dev/null 2>&1; then
            tmux display-message "restored $name from snapshot" 2>/dev/null
            return 0
        fi
        tmux display-message "snapshot restore failed for $name; fresh session" 2>/dev/null
    fi
    tmux new-session -ds "$name" -c "$dir"
    hydrate "$name" "$dir"
}

hydrate() {
    if [ -f $2/.tmux-sessionizer ]; then
        tmux send-keys -t $1 "source $2/.tmux-sessionizer" c-M
    elif [ -f $HOME/.tmux-sessionizer ]; then
        tmux send-keys -t $1 "source $HOME/.tmux-sessionizer" c-M
    fi

    # Start nvim in the primary window of the session, reopening the previous
    # buffers if vim-obsession left a Session.vim behind.
    if [ -f "$2/Session.vim" ]; then
        tmux send-keys -t $1 "nvim -S Session.vim" C-m
    else
        tmux send-keys -t $1 "nvim ." C-m
    fi

    # Open a new tmux window (without running any commands in it)
    tmux new-window -t $1 -c $2

    # Focus back on the window where nvim was started (primary window)
    tmux select-window -t $1:1
}

if [[ $# -eq 1 ]]; then
    selected=$1
else

    # Simulating a dictionary using arrays
    keys=(
        "$HOME/Desktop"
        "$HOME/Downloads"
        "$HOME/Documents"
        "$HOME/Desktop/Flutter/Projects"
        "$HOME/Desktop/KatKode/projects"
        "$HOME"
    )
    values=(
        2
        2
        2
        1
        1
        1
    )

    all_dirs=()

    # Loop through the paths
    for i in "${!keys[@]}"; do
        path="${keys[$i]}"
        depth="${values[$i]}"

        # Ensure paths are properly expanded
        expanded_path=$(eval echo "$path")

        # Check if depth is a number
        if [[ "$depth" =~ ^[0-9]+$ ]]; then
            # Ensure the path is quoted to avoid issues with spaces or special characters
            dirs=$(find "$expanded_path" -mindepth 1 -maxdepth "$depth" -type d 2>/dev/null)
            all_dirs+=($dirs)
        else
            echo "Invalid depth: $depth for path: $expanded_path" >&2
        fi
done

# Remove duplicates and use fzf
selected=$(printf "%s\n" "${all_dirs[@]}" | sort -u | fzf)
fi

if [[ -z $selected ]]; then
    exit 0
fi

new_name=$(session_name_for "$selected")
legacy_name=$(legacy_session_name_for "$selected")

# Backward compatible: the 42 sessions already in the snapshot use the old
# basename-only scheme. Prefer whatever already exists live, then whatever the
# snapshot knows, and only fall back to the new scheme for genuinely new work.
saved_name=$(snapshot_session_for_path "$selected" 2>/dev/null)

if has_session "$new_name" 2>/dev/null; then
    selected_name="$new_name"            # already open under the new scheme
elif has_session "$legacy_name" 2>/dev/null; then
    selected_name="$legacy_name"         # already open under the old scheme
elif [ -n "$saved_name" ] && has_session "$saved_name" 2>/dev/null; then
    selected_name="$saved_name"          # already open under its saved name
elif [ -n "$saved_name" ]; then
    selected_name="$saved_name"          # saved state exists for this FOLDER
elif snapshot_has "$legacy_name"; then
    selected_name="$legacy_name"
else
    selected_name="$new_name"            # genuinely new project
fi

tmux_running=$(pgrep tmux)

if [[ -z $TMUX ]] && [[ -z $tmux_running ]]; then
    start_session "$selected_name" "$selected"
    tmux attach-session -t "$selected_name"
    exit 0
fi

if ! has_session $selected_name; then
    start_session "$selected_name" "$selected"
fi

switch_to $selected_name
