#!/usr/bin/env bash
#
# Snapshot the live tmux state to a machine-local file so a restart is survivable.
#
# Captures sessions, window layouts, pane cwds, and — the part that is not
# recoverable afterwards — the mapping from each `claude` pane to the specific
# Claude Code session id it is running. Transcripts under ~/.claude/projects/
# outlive the panes, but nothing on disk records WHICH pane held WHICH
# conversation; that mapping is what this file preserves.
#
# Writes to ~/.local/share/tmux-state/snapshot by default (override with
# $TMUX_SNAPSHOT_DIR or a path argument).
#
# Read-only with respect to the tmux server: tmux list-*, ps, and file reads.
# Safe to run at any time, and meant to be re-run often (state drifts fast).

set -uo pipefail

parent_path=$( cd "$(dirname "${BASH_SOURCE[0]}")" ; pwd -P )
SNAPDIR="${TMUX_SNAPSHOT_DIR:-$HOME/.local/share/tmux-state}"
OUT="${1:-$SNAPDIR/snapshot}"
HISTDIR="$SNAPDIR/history"
# Retention: every snapshot for the last day, then one per day. Continuum fires
# every 15 min (~96/day), so keeping them all for months would be ~170MB of
# near-identical files; thinning to daily keeps ~90 days in a few MB.
KEEP_ALL_HOURS="${TMUX_SNAPSHOT_KEEP_ALL_HOURS:-24}"
# The prompt's trailing marker, used to find where typed input begins on the
# cursor row. Comes from `%% ` in dots/.zprofile. If the prompt changes, change
# this -- extraction fails CLOSED (records nothing) rather than guessing.
PROMPT_TERMINATOR="${TMUX_PROMPT_TERMINATOR:-% }"
PENDING_MAX_LEN="${TMUX_PENDING_MAX_LEN:-500}"
KEEP_DAYS="${TMUX_SNAPSHOT_KEEP_DAYS:-120}"
mkdir -p "$(dirname "$OUT")" "$HISTDIR"

# Honour TMUX_SOCKET so a snapshot can be taken against a throwaway server
# (tmux -L <name>) for testing without touching the real one.
TM=(tmux)
[ -n "${TMUX_SOCKET:-}" ] && TM=(tmux -L "$TMUX_SOCKET")

if ! command -v tmux &> /dev/null; then
    echo "tmux not installed; nothing to snapshot." >&2
    exit 1
fi

if ! "${TM[@]}" list-sessions &> /dev/null; then
    echo "No tmux server running; nothing to snapshot." >&2
    exit 1
fi

TAB=$'\t'
STAGE=$(mktemp "${TMPDIR:-/tmp}/tmux-snapshot.XXXXXX")
trap 'rm -f "$STAGE"' EXIT

{
    echo "# tmux state snapshot"
    echo "# generated: $(date -u '+%Y-%m-%dT%H:%M:%SZ')"
    echo "# host: $(hostname -s)   tmux: $(tmux -V)"
    echo "#"
    echo "# Line types: session / window / pane / claude"
    echo "# Fields are TAB-separated. 'window' carries tmux's own window_layout"
    echo "# string, which is enough to rebuild exact pane geometry."
    echo "#"

    "${TM[@]}" list-sessions -F "session${TAB}#{session_name}${TAB}#{session_windows}${TAB}#{session_created}${TAB}#{session_path}"

    "${TM[@]}" list-windows -a -F "window${TAB}#{session_name}${TAB}#{window_index}${TAB}#{window_name}${TAB}#{window_active}${TAB}#{window_layout}"

    "${TM[@]}" list-panes -a -F "pane${TAB}#{session_name}${TAB}#{window_index}.#{pane_index}${TAB}#{pane_active}${TAB}#{pane_current_command}${TAB}#{pane_current_path}${TAB}#{pane_pid}"
} > "$STAGE"

# ── pending input (typed but not executed) ──────────────────────────────────
# A pane you restored and never pressed Enter in still holds its command on the
# prompt. Record it so a later restore types it back.
#
# Extraction uses the cursor, not the last visible line: capture-pane TRIMS
# trailing whitespace, so the prompt's trailing space is gone and there is
# nothing to split on. Truncating the cursor row to #{cursor_x} first restores
# that boundary, after which everything past the last terminator is the input.
# An idle prompt yields the empty string, which is exactly what we want.
{
    while IFS=$'\t' read -r psess pidx pcmd pcy pcx; do
        [ -n "$psess" ] || continue
        case "$pcmd" in
            zsh|bash|sh|fish) ;;
            *) continue ;;              # a program is running; no prompt to read
        esac
        [ "$pcx" -gt 0 ] 2>/dev/null || continue
        row=$("${TM[@]}" capture-pane -p -t "=$psess:${pidx%%.*}" -S "$pcy" -E "$pcy" 2>/dev/null | head -1)
        padded=$(printf '%-*s' "$pcx" "$row")
        slice=${padded:0:$pcx}
        # fail closed: no terminator on the row means we cannot tell prompt from
        # input, so record nothing rather than the whole line
        case "$slice" in
            *"$PROMPT_TERMINATOR"*) ;;
            *) continue ;;
        esac
        text=${slice##*"$PROMPT_TERMINATOR"}
        [ -n "$text" ] || continue
        text=${text%"${text##*[![:space:]]}"}          # strip trailing spaces
        [ "${#text}" -le "$PENDING_MAX_LEN" ] || continue
        printf 'pending\t%s\t%s\t%s\n' "$psess" "$pidx" "$text"
    done < <("${TM[@]}" list-panes -a -F "#{session_name}${TAB}#{window_index}.#{pane_index}${TAB}#{pane_current_command}${TAB}#{cursor_y}${TAB}#{cursor_x}")
} >> "$STAGE"

# ── claude pane -> session id ────────────────────────────────────────────────
# Correlate each claude process's start time against the first `timestamp` in
# each candidate transcript. A directory holding exactly one transcript is
# unambiguous regardless of the delta (the process may have been resumed long
# after the conversation began).
python3 - "$STAGE" <<'PY_EOF' 2>/dev/null || echo "# claude mapping skipped (python3 unavailable)" >> "$OUT"
import datetime, glob, json, os, re, subprocess, sys

out = sys.argv[1]

TMUX_CMD = ['tmux']
if os.environ.get('TMUX_SOCKET'):
    TMUX_CMD = ['tmux', '-L', os.environ['TMUX_SOCKET']]

panes = [l.split('\t') for l in subprocess.run(
    TMUX_CMD + ['list-panes', '-a', '-F',
     '#{pane_current_command}\t#{session_name}\t#{window_index}\t'
     '#{pane_current_path}\t#{pane_pid}'],
    capture_output=True, text=True).stdout.strip().split('\n') if l]

# Claude Code does NOT always report as "claude": it frequently shows up in
# pane_current_command as its own version string (2.1.285, 2.1.293, ...).
# Matching only on "claude" missed 13 of 23 panes on this machine -- more than
# it caught -- and those would have restored as bare shells with the
# conversation unreachable. Treat anything version-shaped, or node, as a
# candidate and confirm by reading the process command line.
VERSIONISH = re.compile(r'^\d+\.\d+\.\d+')
RESUME_ID  = re.compile(r'--resume[= ]+([0-9a-f-]{36})')

def descendants(pid, depth=0):
    if depth > 3:
        return []
    kids = subprocess.run(['pgrep', '-P', str(pid)],
                          capture_output=True, text=True).stdout.split()
    out = []
    for k in kids:
        out.append(k)
        out.extend(descendants(k, depth + 1))
    return out

def cmdline(pid):
    return subprocess.run(['ps', '-o', 'command=', '-p', str(pid)],
                          capture_output=True, text=True).stdout.strip()

def claude_proc(shell_pid):
    """Return (pid, cmdline) of a claude process under this pane, or None."""
    for k in descendants(shell_pid):
        c = cmdline(k)
        if 'claude' in c.lower():
            return k, c
    return None

def slug(path):
    # '/', '_' and '.' all collapse to '-'; case is PRESERVED; the leading '/'
    # becomes the leading '-'. Verified against every real project dir.
    return re.sub(r'[/_.]', '-', path)

def started(pid):
    s = cmdline  # placeholder to keep names distinct
    r = subprocess.run(['ps', '-o', 'lstart=', '-p', str(pid)],
                       capture_output=True, text=True).stdout.strip()
    try:
        return (datetime.datetime.strptime(r, '%a %b %d %H:%M:%S %Y')
                .astimezone(datetime.timezone.utc))
    except Exception:
        return None

def first_ts(path):
    try:
        with open(path) as fh:
            for line in fh:
                try:
                    t = json.loads(line).get('timestamp')
                except Exception:
                    continue
                if t:
                    return datetime.datetime.fromisoformat(t.replace('Z', '+00:00'))
    except Exception:
        pass
    return None

rows = []
for cmd, sess, win, cwd, pid in panes:
    if not (cmd == 'claude' or VERSIONISH.match(cmd) or cmd == 'node'):
        continue
    found = claude_proc(pid)
    if found:
        cpid, cline = found
    elif cmd == 'claude':
        # tmux already says this pane is claude. The process walk can come up
        # empty (observed: pane_current_command=claude with no visible
        # descendant of the pane shell), and requiring confirmation here would
        # drop a pane we already know about. Trust tmux; fall back to timing.
        cpid, cline = pid, ''
    elif VERSIONISH.match(cmd):
        # Version-shaped command but the process walk found nothing. That walk
        # legitimately comes up empty (observed on a live claude pane whose
        # shell reported no descendants), so do not drop the pane -- fall back
        # to timing. The transcript-directory check below is the safeguard: if
        # this cwd has no ~/.claude/projects entry it resolves to UNRESOLVED
        # rather than inventing a mapping for an unrelated program.
        cpid, cline = pid, ''
    else:
        # bare 'node' with no claude process underneath: not ours.
        continue

    # Best case: the process was started with --resume, so the id is right there.
    m = RESUME_ID.search(cline)
    if m:
        rows.append(('claude', f'{sess}:{win}', cwd, cpid, m.group(1), '',
                     'from-cmdline', '1'))
        continue

    # Otherwise correlate process start time against each transcript's first
    # timestamp. A directory holding exactly one transcript is unambiguous
    # regardless of delta.
    cands = sorted(glob.glob(os.path.expanduser('~/.claude/projects/')
                             + slug(cwd) + '/*.jsonl'))
    best, delta, note = '', '', ''
    if not cands:
        note = 'UNRESOLVED-no-transcript-dir'
    elif len(cands) == 1:
        best, note = os.path.basename(cands[0])[:-6], 'only-candidate'
    else:
        st = started(cpid)
        scored = []
        for c in cands:
            ft = first_ts(c)
            if ft and st:
                scored.append((abs((ft - st).total_seconds()), c))
        if scored:
            scored.sort()
            d, c = scored[0]
            best, delta = os.path.basename(c)[:-6], f'{int(d)}s'
            note = 'correlated' if d < 3600 else 'LOW-CONFIDENCE'
        else:
            note = f'UNRESOLVED-{len(cands)}-candidates'
    if not best and note.startswith('UNRESOLVED-no-transcript-dir') and cmd != 'claude':
        # version-shaped, unconfirmed, and no transcript for this folder:
        # almost certainly not Claude Code. Leave it out.
        continue
    rows.append(('claude', f'{sess}:{win}', cwd, cpid, best, delta, note,
                 str(len(cands))))

with open(out, 'a') as fh:
    fh.write('#\n# claude\tpane\tcwd\tpid\tsession_id\tdelta\tnote\tcandidates\n')
    for r in rows:
        fh.write('\t'.join(r) + '\n')
PY_EOF


# ── merge with the previous snapshot ─────────────────────────────────────────
# A snapshot must NOT be a plain overwrite. After a reboot only a session or
# two is open, so a wholesale replace would throw away the saved state of every
# project that is not currently running -- exactly the state you want to
# restore from. Sessions that are live are refreshed; sessions only present in
# the previous snapshot are carried forward with their last-seen date, and are
# dropped once they have not been seen for $KEEP_DAYS days.
python3 - "$STAGE" "$OUT" "$KEEP_DAYS" <<'MERGE' || cp "$STAGE" "$OUT"
import datetime, os, sys

stage, out, keep_days = sys.argv[1], sys.argv[2], float(sys.argv[3])
now = datetime.datetime.now(datetime.timezone.utc)
today = now.strftime('%Y-%m-%dT%H:%M:%SZ')

def load(path):
    """-> (header_lines, {session: [lines]}, {session: last_seen})"""
    hdr, by, seen = [], {}, {}
    if not os.path.exists(path):
        return hdr, by, seen
    for line in open(path):
        line = line.rstrip('\n')
        if not line:
            continue
        if line.startswith('#'):
            hdr.append(line)
            continue
        f = line.split('\t')
        kind = f[0]
        if kind == 'seen' and len(f) >= 3:
            seen[f[1]] = f[2]
            continue
        if kind == 'claude' and len(f) >= 2:
            key = f[1].rsplit(':', 1)[0]      # pane is "<session>:<window>"
        elif len(f) >= 2:
            key = f[1]
        else:
            continue
        by.setdefault(key, []).append(line)
    return hdr, by, seen

new_hdr, new_by, _        = load(stage)
_,       old_by, old_seen = load(out)

live = set(new_by)
merged, seen_out, carried, dropped = {}, {}, 0, 0

BARE_SHELLS = {'zsh', 'bash', 'sh', 'fish', ''}

def claude_keys(lines):
    """{'<session>:<window>': line} for the claude entries in a session block."""
    out = {}
    for line in lines:
        f = line.split('\t')
        if f[0] == 'claude' and len(f) >= 2:
            out[f[1]] = line
    return out

def idle_panes(lines):
    """{'<session>:<window>': cwd} for panes sitting at a bare shell."""
    out = {}
    for line in lines:
        f = line.split('\t')
        if f[0] == 'pane' and len(f) >= 6 and f[4] in BARE_SHELLS:
            out[f[1] + ':' + f[2].split('.')[0]] = f[5]
    return out

carried_panes = 0

for sess, lines in new_by.items():
    # A live session is refreshed wholesale -- but that drops the claude entry
    # for any pane whose command is only TYPED and not running. Such a pane
    # reports pane_current_command=zsh, so detection cannot see it, and the
    # session-id mapping would be lost with nothing to recover it from.
    #
    # Re-attach the previous entry when the pane is still an idle shell in the
    # same directory. Deterministic: no screen parsing involved.
    old_cl = claude_keys(old_by.get(sess, []))
    if old_cl:
        new_cl = claude_keys(lines)
        idle = idle_panes(lines)
        for key, old_line in old_cl.items():
            if key in new_cl:
                continue                      # detected live, nothing to do
            if key not in idle:
                continue                      # pane gone, or running something
            f = old_line.split('\t')
            if len(f) >= 3 and f[2] != idle[key]:
                continue                      # pane moved to another directory
            if len(f) >= 7 and 'carried-pane' not in f[6]:
                f[6] = f[6] + '+carried-pane'
            lines = lines + ['\t'.join(f)]
            carried_panes += 1

    merged[sess] = lines
    seen_out[sess] = today

for sess, lines in old_by.items():
    if sess in live:
        continue
    last = old_seen.get(sess, today)
    try:
        age_days = (now - datetime.datetime.fromisoformat(
            last.replace('Z', '+00:00'))).total_seconds() / 86400.0
    except Exception:
        age_days = 0.0
    if age_days > keep_days:
        dropped += 1
        continue
    merged[sess] = lines
    seen_out[sess] = last
    carried += 1

with open(out, 'w') as fh:
    for h in new_hdr:
        fh.write(h + '\n')
    fh.write('# Sessions not currently running are carried over from the previous\n')
    fh.write('# snapshot; the "seen" lines record when each was last seen live.\n#\n')
    for sess in sorted(merged):
        for line in merged[sess]:
            fh.write(line + '\n')
    for sess in sorted(seen_out):
        fh.write(f'seen\t{sess}\t{seen_out[sess]}\n')

print(f'  live={len(live)} carried={carried} dropped={dropped} carried-panes={carried_panes}', file=sys.stderr)
MERGE

# ── history ──────────────────────────────────────────────────────────────────
# Keep a dated copy so a folder's pane state can be rolled back weeks later.
STAMP=$(date -u '+%Y%m%dT%H%M%SZ')
cp "$OUT" "$HISTDIR/snapshot-$STAMP.tsv" 2>/dev/null

python3 - "$HISTDIR" "$KEEP_ALL_HOURS" "$KEEP_DAYS" <<'PRUNE' 2>/dev/null
import os, re, sys, time
d, keep_all_h, keep_days = sys.argv[1], float(sys.argv[2]), float(sys.argv[3])
now = time.time()
pat = re.compile(r'^snapshot-(\d{8})T\d{6}Z\.tsv$')
files = []
for n in os.listdir(d):
    m = pat.match(n)
    if m:
        files.append((os.path.getmtime(os.path.join(d, n)), m.group(1), n))
files.sort(reverse=True)            # newest first
seen_days, kept = set(), 0
for mtime, day, name in files:
    age_h = (now - mtime) / 3600.0
    if age_h <= keep_all_h:
        kept += 1
        continue                     # recent: keep everything
    if age_h / 24.0 > keep_days:
        os.remove(os.path.join(d, name))
        continue                     # too old
    if day in seen_days:
        os.remove(os.path.join(d, name))
        continue                     # already have a newer one that day
    seen_days.add(day)
    kept += 1
PRUNE

s=$(grep -c '^session' "$OUT")
w=$(grep -c '^window'  "$OUT")
p=$(grep -c '^pane'    "$OUT")
c=$(grep -c '^claude'  "$OUT")
echo "Wrote $(cd "$(dirname "$OUT")" && pwd)/$(basename "$OUT")"
echo "  $s sessions, $w windows, $p panes, $c claude panes mapped"
echo "  history: $(ls "$HISTDIR" 2>/dev/null | wc -l | tr -d ' ') snapshots kept in ${HISTDIR/#$HOME/~}"

unresolved=$(grep '^claude' "$OUT" | grep -c 'UNRESOLVED')
lowconf=$(grep '^claude' "$OUT" | grep -c 'LOW-CONFIDENCE')
[ "$unresolved" -gt 0 ] && echo "  WARNING: $unresolved claude pane(s) unresolved"
[ "$lowconf" -gt 0 ]    && echo "  NOTE: $lowconf claude pane(s) low-confidence (verify with: claude -r)"
exit 0
