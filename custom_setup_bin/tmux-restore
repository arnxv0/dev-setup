#!/usr/bin/env bash
#
# Restore tmux sessions from a snapshot written by tmux-snapshot.
#
# Selective by design: restores ONE named session by default, so you rebuild
# only what you need instead of spawning every pane at once.
#
# Safety properties:
#   * NEVER touches a session that already exists -- it is skipped, not merged
#     and not killed. Nothing live can be clobbered by running this.
#   * New sessions are created detached; your current view is not yanked around.
#   * --dry-run prints the exact tmux commands without running any of them.
#   * Honours $TMUX_SOCKET so a restore can be rehearsed on a throwaway server
#     (TMUX_SOCKET=rtest tmux-restore foo) with zero risk to the real one.
#
# Written for bash 3.2 (macOS system bash): no mapfile, no assoc arrays.

set -uo pipefail

parent_path=$( cd "$(dirname "${BASH_SOURCE[0]}")" ; pwd -P )
SNAP="${SNAP:-${TMUX_SNAPSHOT_DIR:-$HOME/.local/share/tmux-state}/snapshot}"
DRY=0
ALL=0
ATTACH=0
PLACEHOLDER=9999   # scratch window index, killed once real windows exist

TM=(tmux)
[ -n "${TMUX_SOCKET:-}" ] && TM=(tmux -L "$TMUX_SOCKET")

usage() {
    cat <<USAGE
usage: tmux-restore [options] <session-name> [session-name ...]
       tmux-restore --list
       tmux-restore --all

options:
  --list        show sessions in the snapshot and whether each is already live
  --all         restore every session in the snapshot (asks for confirmation)
  --dry-run     print what would happen; change nothing
  --history     list dated snapshots available to roll back to
  --from S      restore from a dated snapshot instead of the current one
                (S is a timestamp from --history, or a file path)
  -a, --attach  after restoring, attach to it (or switch, if already in tmux).
                Works with no tmux server running -- one command from a bare
                terminal is enough; you do not need to start tmux first.
  -h, --help    this message

env:
  SNAP=<path>          use a different snapshot file
  TMUX_SOCKET=<name>   operate on 'tmux -L <name>' instead of the default server

Existing sessions are always skipped, never modified.
USAGE
}

# field-exact lookups -- awk, not grep, so index 3 never matches 31
snap_sessions()  { awk -F'\t' '$1=="session" {print $2}' "$SNAP"; }
snap_has_sess()  { awk -F'\t' -v s="$1" '$1=="session" && $2==s {f=1} END{exit !f}' "$SNAP"; }
snap_windows()   { awk -F'\t' -v s="$1" '$1=="window" && $2==s {print}' "$SNAP" | sort -t"$(printf '\t')" -k3,3n; }
snap_panes()     { awk -F'\t' -v s="$1" -v w="$2" '
                     $1=="pane" && $2==s { split($3,a,"."); if (a[1]==w) print a[2]"\t"$5"\t"$6 }
                   ' "$SNAP" | sort -k1,1n; }
snap_claude_id() { awk -F'\t' -v k="$1" '$1=="claude" && $2==k {print $5; exit}' "$SNAP"; }

# Find the saved session for a FOLDER, not a name.
#
# This is the lookup that matters: you pick a directory with prefix+f, and the
# saved state should be found regardless of what the session happened to be
# called. Matches the session's own path first, then any pane's cwd. If two
# sessions cover the same folder (e.g. "disd" and "CS249-discord-service" both
# live in CS249-discord-service), the one with more windows wins.
snap_session_for_path() {
    local dir="${1%/}"
    awk -F'\t' -v d="$dir" '
        $1=="session" { wins[$2]=$3; if ($5==d) hit[$2]=1 }
        $1=="pane"    { if ($6==d) hit[$2]=1 }
        END { best=""; bw=-1
              for (s in hit) if (wins[s]+0 > bw) { bw=wins[s]+0; best=s }
              if (best!="") print best }
    ' "$SNAP"
}

TARGETS=()
while [ $# -gt 0 ]; do
    case "$1" in
        --dry-run) DRY=1 ;;
        -a|--attach) ATTACH=1 ;;
        --history)
            hd="${TMUX_SNAPSHOT_DIR:-$HOME/.local/share/tmux-state}/history"
            echo "dated snapshots in ${hd/#$HOME/~} (newest first):"
            ls -t "$hd"/snapshot-*.tsv 2>/dev/null | while IFS= read -r f; do
                printf '  %-26s %3s sessions  %4s panes  %s\n' \
                    "$(basename "$f" .tsv | sed 's/^snapshot-//')" \
                    "$(grep -c '^session' "$f")" "$(grep -c '^pane' "$f")" \
                    "$(grep -c '^claude' "$f") claude"
            done
            [ -d "$hd" ] || echo "  (none yet)"
            exit 0 ;;
        --from)
            shift
            f="${1:-}"
            hd="${TMUX_SNAPSHOT_DIR:-$HOME/.local/share/tmux-state}/history"
            if   [ -f "$f" ]; then SNAP="$f"
            elif [ -f "$hd/snapshot-$f.tsv" ]; then SNAP="$hd/snapshot-$f.tsv"
            else
                # allow a prefix, e.g. --from 20261010
                cand=$(ls -t "$hd"/snapshot-"$f"*.tsv 2>/dev/null | head -1)
                [ -n "$cand" ] && SNAP="$cand" || { echo "no snapshot matching: $f" >&2; exit 1; }
            fi
            echo "using snapshot: ${SNAP/#$HOME/~}" ;;
        --all)     ALL=1 ;;
        --list)
            [ -f "$SNAP" ] || { echo "no snapshot at $SNAP" >&2; exit 1; }
            printf '%-32s %7s %7s  %s\n' SESSION WINDOWS STATUS PATH
            while IFS="$(printf '\t')" read -r _ name nwin _ spath; do
                if "${TM[@]}" has-session -t "=$name" 2>/dev/null; then st=live; else st=absent; fi
                printf '%-32s %7s %7s  %s\n' "$name" "$nwin" "$st" "$spath"
            done < <(awk -F'\t' '$1=="session"' "$SNAP")
            exit 0 ;;
        -h|--help) usage; exit 0 ;;
        -*) echo "unknown option: $1" >&2; usage >&2; exit 2 ;;
        *)  TARGETS+=("$1") ;;
    esac
    shift
done

[ -f "$SNAP" ] || { echo "no snapshot at $SNAP -- run tmux-snapshot first" >&2; exit 1; }

if [ "$ALL" -eq 1 ]; then
    while IFS= read -r s; do TARGETS+=("$s"); done < <(snap_sessions)
    echo "About to restore ${#TARGETS[@]} session(s). This starts a lot of processes."
    printf 'Continue? [y/N] '
    read -r reply
    case "$reply" in [yY]*) ;; *) echo "aborted."; exit 0 ;; esac
fi

[ "${#TARGETS[@]}" -gt 0 ] || { usage >&2; exit 2; }

run() {
    if [ "$DRY" -eq 1 ]; then printf '  + %s\n' "$*"; else "$@"; fi
}


restored=0; skipped=0; missing=0; incomplete=0

for sess in "${TARGETS[@]}"; do
    # a directory argument is resolved to whatever session was saved for it
    if [ -d "$sess" ]; then
        resolved=$(snap_session_for_path "$sess")
        if [ -n "$resolved" ]; then
            echo "== $sess -> saved session '$resolved'"
            sess="$resolved"
        else
            echo "!! no saved session for folder $sess"
            missing=$((missing+1)); continue
        fi
    fi
    if ! snap_has_sess "$sess"; then
        echo "!! '$sess' is not in the snapshot -- skipping"
        missing=$((missing+1)); continue
    fi

    if "${TM[@]}" has-session -t "=$sess" 2>/dev/null; then
        echo "== $sess already live -- skipping (never clobbered)"
        skipped=$((skipped+1)); continue
    fi

    wins=()
    while IFS= read -r l; do wins+=("$l"); done < <(snap_windows "$sess")
    if [ "${#wins[@]}" -eq 0 ]; then
        echo "!! $sess has no windows recorded -- skipping"
        missing=$((missing+1)); continue
    fi

    echo "== restoring $sess (${#wins[@]} windows)"

    # Create the session holding only a scratch window parked at a high index,
    # so every real window can be created at its exact recorded index without
    # ever colliding with the auto-created first window.
    run "${TM[@]}" new-session -d -s "$sess" -c "$HOME"
    if [ "$DRY" -eq 0 ]; then
        # NOTE: 'display -p' returns empty with no attached client, which is
        # always the case for a freshly detached session. list-windows works.
        cur=$("${TM[@]}" list-windows -t "=$sess" -F '#{window_index}' 2>/dev/null | head -1)
        if [ -z "$cur" ]; then
            echo "!! could not determine scratch window index for $sess -- skipping"
            "${TM[@]}" kill-session -t "=$sess" 2>/dev/null
            missing=$((missing+1)); continue
        fi
        if ! "${TM[@]}" move-window -s "=$sess:$cur" -t "=$sess:$PLACEHOLDER" 2>/dev/null; then
            echo "!! could not park scratch window for $sess -- skipping"
            "${TM[@]}" kill-session -t "=$sess" 2>/dev/null
            missing=$((missing+1)); continue
        fi
    else
        printf '  + %s\n' "${TM[*]} move-window -s =$sess:<auto> -t =$sess:$PLACEHOLDER"
    fi

    for wline in "${wins[@]}"; do
        widx=$(printf '%s' "$wline"  | cut -f3)
        wname=$(printf '%s' "$wline" | cut -f4)
        wlayout=$(printf '%s' "$wline" | cut -f6)

        panes=()
        while IFS= read -r l; do panes+=("$l"); done < <(snap_panes "$sess" "$widx")
        [ "${#panes[@]}" -eq 0 ] && continue

        p1cwd=$(printf '%s' "${panes[0]}" | cut -f3)
        [ -d "$p1cwd" ] || p1cwd="$HOME"
        p1cmd=$(printf '%s' "${panes[0]}" | cut -f2)

        # Commands are TYPED into the pane, never executed.
        #
        # This is the whole mechanism, and it is deliberately dumb. Auto-running
        # needed a `$SHELL -l -i -c ...` wrapper just to get PATH right (claude
        # lives in ~/.local/bin, added only by .zshrc) and still raced the
        # pane's shell -- send-keys delivers text reliably, but its trailing C-m
        # is swallowed by a shell that is not reading yet.
        #
        # Typing the line sidesteps all of it: you see the exact command, PATH
        # is whatever your interactive shell has, nothing spawns itself, and you
        # press Enter only in the panes you actually want back.
        typed=""
        sid=$(snap_claude_id "$sess:$widx")
        if [ -n "$sid" ]; then
            typed="claude --resume $sid"
            echo "   typed: claude --resume ${sid%%-*}  <- $sess:$widx"
        else
            case "$p1cmd" in
                nvim|vim)
                    if [ -f "$p1cwd/Session.vim" ]; then
                        typed="$p1cmd -S Session.vim"
                    else
                        typed="$p1cmd ."
                    fi
                    echo "   typed: $typed  <- $sess:$widx" ;;
                zsh|bash|sh|"") : ;;
                *) echo "   note: $sess:$widx ran '$p1cmd' -- left as a plain shell" ;;
            esac
        fi

        run "${TM[@]}" new-window -d -t "=$sess:$widx" -n "$wname" -c "$p1cwd"

        # no C-m on purpose: the line waits on the prompt for you to run
        if [ -n "$typed" ]; then
            run "${TM[@]}" send-keys -t "=$sess:$widx" "$typed"
        fi


        # extra panes (rare: this layout is one pane per window)
        i=1
        while [ "$i" -lt "${#panes[@]}" ]; do
            pcwd=$(printf '%s' "${panes[$i]}" | cut -f3)
            [ -d "$pcwd" ] || pcwd="$HOME"
            run "${TM[@]}" split-window -d -t "=$sess:$widx" -c "$pcwd"
            i=$((i+1))
        done
        if [ "${#panes[@]}" -gt 1 ] && [ -n "$wlayout" ]; then
            run "${TM[@]}" select-layout -t "=$sess:$widx" "$wlayout"
        fi
    done

    # drop the scratch window now that the real ones exist
    run "${TM[@]}" kill-window -t "=$sess:$PLACEHOLDER"

    firstwin=$(printf '%s' "${wins[0]}" | cut -f3)
    if [ "$DRY" -eq 0 ]; then
        "${TM[@]}" select-window -t "=$sess:$firstwin" 2>/dev/null
        got=$("${TM[@]}" list-windows -t "=$sess" -F x 2>/dev/null | wc -l | tr -d ' ')
        if [ "$got" != "${#wins[@]}" ]; then
            echo "!! $sess: expected ${#wins[@]} windows, got $got -- INCOMPLETE"
            incomplete=$((incomplete+1))
        else
            echo "   ok: ${#wins[@]}/${#wins[@]} windows"
            restored=$((restored+1))
        fi
    else
        restored=$((restored+1))
    fi
done

# --attach: switch if we are already inside tmux, otherwise attach outright.
# Either works even when this invocation is what started the server.
if [ "$ATTACH" -eq 1 ] && [ "$DRY" -eq 0 ] && [ "${#TARGETS[@]}" -ge 1 ]; then
    first="${TARGETS[0]}"
    if "${TM[@]}" has-session -t "=$first" 2>/dev/null; then
        if [ -n "${TMUX:-}" ]; then
            "${TM[@]}" switch-client -t "=$first" 2>/dev/null \
                || echo "could not switch to $first"
        else
            exec "${TM[@]}" attach-session -t "=$first"
        fi
    else
        echo "cannot attach: $first was not restored"
    fi
fi

echo
echo "restored=$restored  skipped(live)=$skipped  not-in-snapshot=$missing  incomplete=$incomplete"
if [ "$DRY" -eq 1 ]; then
    echo "(dry run -- nothing was changed)"
else
    echo "attach with: ${TM[*]} attach -t <session>"
fi
if [ "$incomplete" -gt 0 ]; then exit 1; fi
exit 0
